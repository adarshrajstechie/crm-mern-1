// ============================================================================
// STUDY NOTE: Prisma Schema Definition for MongoDB
// Prisma ORM translates object structures into database tables/collections.
// For MongoDB, Prisma requires an '@map("_id") @db.ObjectId' attribute for ID fields.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @unique
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String
  company   String
  status    String   @default("Lead") // Lead, Contacted, Customer, Inactive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
